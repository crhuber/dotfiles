#!/usr/bin/env bash
set -e
set -u
set -o pipefail

# check if magick command is available
define check_magick_installed() {
    if ! command -v magick &> /dev/null; then
        echo "magick command not found. Please install ImageMagick."
        echo "You can install it using your package manager, for example:"
        echo "brew install imagemagick"
        exit 1
    fi
}
check_magick_installed

#-delay 100
#Pause for 1 second between frames.

#-loop 5
#Loop the frames five times. Use -loop 0 to loop forever.

#-dispose previous
# Clears the previous frame before drawing the next.

magick $@ \
    -delay 100 \
    -loop 5 \
    -dispose previous \
    output.gif
