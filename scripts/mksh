#!/usr/bin/env bash
set -e
set -u
set -o pipefail

if [ ! $# -eq 1 ]; then
  echo 'mksh takes one argument' 1>&2
  exit 1
fi

f="$1"
[[ "$f" == */* ]] || f="$HOME/.dotfiles/scripts/$f"

if [ -e "$f" ]; then
  echo "$f already exists" 1>&2
  exit 1
fi

echo '#!/usr/bin/env bash
set -e
set -u
set -o pipefail

' > "$f"

chmod u+x "$f"

"$EDITOR" "$f"
