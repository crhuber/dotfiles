#!/usr/bin/env bash
set -e
set -u
set -o pipefail

# read notes_env or use default "Work"
notes_env="${NOTES_ENV:-Work}"

echo "Using notes environment: $notes_env"

# if user proviles -l then cat the notes file
if [ "$1" = "-l" ]; then
    if [ -f "$HOME/Documents/Notes/$notes_env/LOG.md" ]; then
        bat "$HOME/Documents/Notes/$notes_env/LOG.md"
    else
        echo "No notes found."
    fi
    exit 0
fi
# Get the current date and time in YYYY-MM-DD HH:MM:SS format
date=$(date +"%Y-%m-%d %H:%M:%S")

# Get the note text from all arguments
note="$*"

# Create the Notes directory if it doesn't exist
mkdir -p "$HOME/Documents/Notes/$notes_env"

# Append the date and note to the log file
echo "$date $note" >> "$HOME/Documents/Notes/$notes_env/LOG.md"

echo "Log entry added: $date $note"
