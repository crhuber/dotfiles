#!/usr/bin/env bash
set -e
set -u
set -o pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: videoclip <file> <start>-<end>"
  echo "Example: videoclip video.mp4 00:00:30-00:00:45"
  echo "Output will be saved as <input>-clip.<ext>"
  exit 1
fi

input="$1"
window="$2"

start="${window%-*}"
end="${window#*-}"
ext="${input##*.}"
base="${input%.*}"
output="${base}-clip.${ext}"

echo "Clipping video from $start to $end..."

ffmpeg -ss "$start" -to "$end" -i "$input" -c copy "$output"
echo "Video clipped successfully to $output"
