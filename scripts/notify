#!/usr/bin/env python3
import json
import subprocess
import sys
from datetime import datetime


def run(*args: str) -> bool:
    try:
        proc = subprocess.run(args)
    except FileNotFoundError:
        return False
    return proc.returncode >= 0


def notify(title: str, description: str) -> None:
    js = f"""
    var app = Application.currentApplication()
    app.includeStandardAdditions = true
    app.displayNotification({json.dumps(description)}, {{
      withTitle: {json.dumps(title)},
    }})
    """
    if run("osascript", "-l", "JavaScript", "-e", js):
        return

    print("can't send notifications", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    title = sys.argv[1] if len(sys.argv) > 1 else "Notification"
    description = (
        sys.argv[2]
        if len(sys.argv) > 2
        else datetime.now().astimezone().isoformat(timespec="seconds")
    )
    notify(title, description)
